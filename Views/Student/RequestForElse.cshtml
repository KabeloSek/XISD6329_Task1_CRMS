@model XISD6329_Task1_CRMS.Models.CleaningRequestElseModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Request For Someone Else</title>
    <link rel="stylesheet" href="~/css/RequestForElse.css" />
</head>
<body>
    <div class="top-nav">
        <button onclick="location.href='@Url.Action("StudentHome", "Student")'">
            <p class="nav-back">Back</p>
        </button>
        <h2 class="nav-title">Request Cleaning</h2>
        <button onclick="location.href='@Url.Action("StudentNotifications", "Student")'">
            <p class="nav-notif">Notifications</p>
        </button>
    </div>

    <form asp-action="RequestForElse" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>

        <label>Room Number</label>
        <select asp-for="roomNumber">
            <option value="">Choose Room Number</option>

            <!-- Floor 1 -->
            <optgroup label="Floor 1">
                <option value="101">101</option>
                <option value="102">102</option>
                <option value="103">103</option>
                <option value="104">104</option>
                <option value="105">105</option>
                <option value="106">106</option>
                <option value="107">107</option>
                <option value="108">108</option>
                <option value="109">109</option>
                <option value="110">110</option>
            </optgroup>

            <!-- Floor 2 -->
            <optgroup label="Floor 2">
                <option value="201">201</option>
                <option value="202">202</option>
                <option value="203">203</option>
                <option value="204">204</option>
                <option value="205">205</option>
                <option value="206">206</option>
                <option value="207">207</option>
                <option value="208">208</option>
                <option value="209">209</option>
                <option value="210">210</option>
            </optgroup>

            <!-- Floor 3 -->
            <optgroup label="Floor 3">
                <option value="301">301</option>
                <option value="302">302</option>
                <option value="303">303</option>
                <option value="304">304</option>
                <option value="305">305</option>
                <option value="306">306</option>
                <option value="307">307</option>
                <option value="308">308</option>
                <option value="309">309</option>
                <option value="310">310</option>
            </optgroup>

            <!-- Floor 4 -->
            <optgroup label="Floor 4">
                <option value="401">401</option>
                <option value="402">402</option>
                <option value="403">403</option>
                <option value="404">404</option>
                <option value="405">405</option>
                <option value="406">406</option>
                <option value="407">407</option>
                <option value="408">408</option>
                <option value="409">409</option>
                <option value="410">410</option>
            </optgroup>

            <!-- Floor 5 -->
            <optgroup label="Floor 5">
                <option value="501">501</option>
                <option value="502">502</option>
                <option value="503">503</option>
                <option value="504">504</option>
                <option value="505">505</option>
                <option value="506">506</option>
                <option value="507">507</option>
                <option value="508">508</option>
                <option value="509">509</option>
                <option value="510">510</option>
            </optgroup>
        </select>
        <span asp-validation-for="roomNumber"></span>

        <label>Select Date</label>
        <input type="date" asp-for="bookingDate" />
        <span asp-validation-for="bookingDate"></span>

        <label>Select Room Type</label>
        <select asp-for="roomType">
            <option value="Single">Single</option>
            <option value="Sharing">Sharing</option>
            <option value="Bachelor">Bachelor</option>
        </select>
        <span asp-validation-for="roomType"></span>

        <label>Select Time</label>
        <select asp-for="timeSlot">
            <option value="8:30 AM - 10:00 AM">8:30 AM - 10:00 AM</option>
            <option value="10:00 AM - 12:00 PM">10:00 AM - 12:00 PM</option>
            <option value="12:30 PM - 2:00 PM">12:30 PM - 2:00 PM</option>
            <option value="2:00 PM - 4:00 PM">2:00 PM - 4:00 PM</option>
        </select>
        <span asp-validation-for="timeSlot"></span>

        <label>Type of Cleaning</label>
        <select asp-for="cleaningType">
            <option value="Regular">Regular</option>
            <option value="Deep">Deep</option>
            <option value="Move-in/Move-out">Move-in/Move-out</option>
        </select>
        <span asp-validation-for="cleaningType"></span>

        <label>Special Instructions (Optional)</label>
        <input type="text" asp-for="specialInstructions" placeholder="E.g. Please vacuum carpet thoroughly" />

        <label>External Booking ID</label>
        <input type="text" asp-for="externalBookingId" placeholder="Enter the student's External Booking ID (find it in their Profile) to validate this request" />
        <span asp-validation-for="externalBookingId"></span>

        <button type="submit">Submit</button>
    </form>
</body>
</html>