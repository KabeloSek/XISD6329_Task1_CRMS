@model List<XISD6329_Task1_CRMS.Models.BookingViewModel>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Bookings</title>
    <link rel="stylesheet" href="~/css/MyBookings.css" />
</head>
<body>
    <div class="top-nav">
        <button onclick="location.href='@Url.Action("StudentHome", "Student")'">
            <p class="nav-back">Back</p>
        </button>
        <h2 class="nav-title">My Bookings</h2>
        <button onclick="location.href='@Url.Action("StudentNotifications", "Student")'">
            <p class="nav-notif">Notifications</p>
        </button>
    </div>

    <h2>Pending</h2>
    <div class="booking-list">
        @foreach (var booking in Model.Where(b => b.status == "Pending"))
        {
            <div class="booking-card">
                <p class="booking-room">Room @booking.roomNumber</p>
                <p>@booking.bookingDate.ToString("dd MMM yyyy") · @booking.timeSlot</p>
                <p>@booking.cleaningType Cleaning</p>
                <p class="booking-cleaner">Waiting for a cleaner to accept</p>
            </div>
        }
        @if (!Model.Any(b => b.status == "Pending"))
        {
            <p class="empty-state">No pending requests.</p>
        }
    </div>

    <h2>In Progress</h2>
    <div class="booking-list">
        @foreach (var booking in Model.Where(b => b.status == "In Progress"))
        {
            <div class="booking-card">
                <p class="booking-room">Room @booking.roomNumber</p>
                <p>@booking.bookingDate.ToString("dd MMM yyyy") · @booking.timeSlot</p>
                <p>@booking.cleaningType Cleaning</p>
                <p class="booking-cleaner">Cleaner: @booking.cleanerName</p>
            </div>
        }
        @if (!Model.Any(b => b.status == "In Progress"))
        {
            <p class="empty-state">No bookings currently in progress.</p>
        }
    </div>

    <h2>Completed</h2>
    <div class="booking-list">
        @foreach (var booking in Model.Where(b => b.status == "Completed"))
        {
            <div class="booking-card">
                <p class="booking-room">Room @booking.roomNumber</p>
                <p>@booking.bookingDate.ToString("dd MMM yyyy") · @booking.timeSlot</p>
                <p>@booking.cleaningType Cleaning</p>
                <p class="booking-cleaner">Cleaner: @booking.cleanerName</p>
            </div>
        }
        @if (!Model.Any(b => b.status == "Completed"))
        {
            <p class="empty-state">No completed bookings yet.</p>
        }
    </div>

    <button onclick="location.href='@Url.Action("WhoCleaningIsFor", "Student")'">Request Cleaning</button>
</body>
</html>