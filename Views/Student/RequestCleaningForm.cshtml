<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Request For Someone Else</title>

</head>
<body>
    <div class="top-nav">
        <button onclick="location.href='@Url.Action("StudentHome", "Student")'">
            <p class="nav-back">Back</p>
        </button>

        <h2 class="nav-title">Request Cleaning</h2>

        <button onclick="location.href='@Url.Action("StudentNotifications", "Student")'">
            <p class="nav-notif">Notifications</p>
        </button>
    </div>

    <form>

        <label>Room Number</label><br />
        <p>Room Number</p>
        <br />

        <label>Select Date</label><br />
        <input type="date" /><br />

        <label>Select Rooom Type</label><br />
        <select>
            <option value="Single">Single</option>
            <option value="Sharing">Sharing</option>
            <option value="Bachelor">Bachelor</option>

        </select><br />

        <label>Select Room Type</label><br />
        <select>
            <option value="8:30 AM - 10:00 PM">8:30 AM - 10:00 PM</option>
            <option value="10:00 AM - 12:00 PM">10:00 AM - 12:00 PM</option>
            <option value="12:30 PM - 14:00 PM">12:30 PM - 14:00 PM</option>
            <option value="14:00 PM - 16:00 PM">14:00 PM - 16:00 PM</option>
        </select><br />

        <label>Type of Cleaning</label><br />
        <select>
            <option value="Single">Regular</option>
            <option value="Sharing">Deep</option>
            <option value="Bachelor">Move-in/Move-out</option>

        </select><br />

        <label>Special Instructions (Optional)</label><br />
        <input type="text" placeholder="E.g. Please vacuum carpert thoroughly" style="width: 250px; height: 30px;" /><br />

        <button type="submit">Submit</button>
    </form>

    <a href="@Url.Action("MyBookings", "Student")">My Bookings</a>
    <br />

    <a href="@Url.Action("Profile", "Student")">Profile</a>

</body>
</html>