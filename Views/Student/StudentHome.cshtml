<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!-- Responsive design -->
    <title>Student Dashboard</title>

    <link rel="stylesheet" href="~/css/StudentDashboard.css" />


</head>
<body>
    <header class="dashboard-header">
       <h1>Hello "Student Name"</h1>
       <p>What would you like to do today</p>
    </header>

   <div class="card-grid">
       <div class="card">
            <button onclick="location.href='@Url.Action("WhoCleaningIsFor", "Student")'">
                <p class="card-title"><b>Request Cleaning</b></p>
                <p class="card-subtitle">Book Cleaning Service</p>
            </button>
       </div>

       <div class="card">
            <button onclick="location.href='@Url.Action("StudentBookings", "Student")'">
               <p class="card-title"><b>My Bookings</b></p>
               <p class="card-subtitle">View your cleaning requests</p>
           </button>
       </div>

       <div class="card">
            <button onclick="location.href='@Url.Action("StudentProfile", "Student")'">
                <p class="card-title"><b>Profile</b></p>
                <p class="card-subtitle">Manage your profile</p>
            </button>
       </div>

       <div class="card">
            <button onclick="location.href='@Url.Action("StudentHelp_Support", "Student")'">
                <p class="card-title"><b>Help & Support</b></p>
                <p class="card-subtitle">Get help and information</p>
            </button>
       </div>
       
   </div>

   <button class="logout-btn">
       Logout
   </button>

</body>
</html>