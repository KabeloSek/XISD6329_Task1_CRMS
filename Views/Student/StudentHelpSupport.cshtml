<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!-- Responsive design -->
    <title>Help & Support</title>

    <link rel="stylesheet" href="~/css/StudentDashboard.css" />


</head>
<body>
    <header class="dashboard-header">
        <h1>Hello "Student Name"</h1>
        <p>What would you like to do today</p>
    </header>

    <div class="card-grid">
        <div class="card">
            <button onclick="location.href='@Url.Action("WhoCleaningIsFor", "Student")'">
                <p class="card-title"><b>Request Cleaning</b></p>
                <p class="card-subtitle">Book Cleaning Service</p>
            </button>
        </div>

        <div class="card">
            <button onclick="location.href='@Url.Action("MyBookings", "Student")'">
                <p class="card-title"><b>My Bookings</b></p>
                <p class="card-subtitle">View your cleaning requests</p>
            </button>
        </div>

        <div class="card">
            <button onclick="location.href='@Url.Action("StudentProfile", "Student")'">
                <p class="card-title"><b>Profile</b></p>
                <p class="card-subtitle">Manage your profile</p>
            </button>
        </div>

        <div class="card">
            <button onclick="location.href='@Url.Action("StudentHelpSupport", "Student")'">
                <p class="card-title"><b>Help & Support</b></p>
                <p class="card-subtitle">Get help and information</p>
            </button>
        </div>

    </div>

    <button class="logout-btn">
        Logout
    </button>

    <!-- Help & Support section added -->
    <div class="help-support-container">

        <h1>Help & Support</h1>

        <div class="help-section">
            <h2>FAQs</h2>

            <button onclick="location.href='@Url.Action("CleaningGuidelines", "Student")'">
                Cleaning Guidelines
            </button>

            <button onclick="location.href='@Url.Action("ContactResidenceManagement", "Student")'">
                Contact Residence Management
            </button> 
        </div>

        <div class="help-section">
            <h2>Report a Problem</h2>

            <p>If you are experiencing a problem, you can click on the report button below.</p>

            <button onclick="location.href='@Url.Action("ReportProblem", "Student")'">
                Report a Problem
            </button>
        </div>

    </div>
</body>
</html>