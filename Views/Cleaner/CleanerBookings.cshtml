@model List<XISD6329_Task1_CRMS.Models.BookingViewModel>
<!DOCTYPE html>
<html lang="en">
<head>
    <title>My Bookings</title>
    <link rel="stylesheet" href="~/css/MyBookings.css" />
</head>
<body>
    <div class="top-nav">
        <button onclick="location.href='@Url.Action("CleanerHome", "Cleaner")'">
            <p class="nav-back">Back</p>
        </button>
        <h2 class="nav-title">My Bookings</h2>
    </div>

    @if (TempData["Error"] != null)
    {
        <p class="profile-message">@TempData["Error"]</p>
    }

    <h2>In Progress</h2>
    <div class="booking-list">
        @foreach (var booking in Model.Where(b => b.status == "In Progress"))
        {
            <div class="booking-card">
                <p class="booking-room">Room @booking.roomNumber</p>
                <p>@booking.bookingDate.ToString("dd MMM yyyy") · @booking.timeSlot</p>
                <p>@booking.cleaningType Cleaning</p>
                <form asp-controller="Cleaner" asp-action="CompleteBooking" method="post">
                    <input type="hidden" name="bookingId" value="@booking.bookingId" />
                    <input type="text" name="passkey" placeholder="Ask student for passkey" required />
                    <button type="submit" class="save-btn">Mark Complete</button>
                </form>
            </div>
        }
        @if (!Model.Any(b => b.status == "In Progress"))
        {
            <p class="empty-state">Nothing in progress.</p>
        }
    </div>

    <h2>Completed</h2>
    <div class="booking-list">
        @foreach (var booking in Model.Where(b => b.status == "Completed"))
        {
            <div class="booking-card">
                <p class="booking-room">Room @booking.roomNumber</p>
                <p>@booking.bookingDate.ToString("dd MMM yyyy") · @booking.timeSlot</p>
                <p>@booking.cleaningType Cleaning</p>
            </div>
        }
        @if (!Model.Any(b => b.status == "Completed"))
        {
            <p class="empty-state">Nothing completed yet.</p>
        }
    </div>
</body>
</html>