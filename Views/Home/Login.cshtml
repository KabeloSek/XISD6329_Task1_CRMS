@model XISD6329_Task1_CRMS.Models.LoginModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!-- Responsive design -->
    <title>Student Login</title>

<link rel="stylesheet" href="~/css/Login.css" />
</head>
<body>
    <img src="/images/SouthPointLogo(1).png" width="400" height="250" alt="Site Logo" />

    <div class="wel-Back">
        <h1>Welcome Back</h1>
        <p>Please login to continue</p>
    </div>

    <form asp-action="Login" method="post" class="form-container">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group">
            <label>Email:</label><br />
            <input type="email" asp-for="email" placeholder="Enter email" />
            <span asp-validation-for="email"></span>
        </div>

        <div class="form-group">
            <label>Password:</label><br />
            <input type="password" asp-for="password" placeholder="Enter password" />
            <span asp-validation-for="password"></span>
        </div>

        <button type="submit" class="btn">Login</button>
    </form>

    <div class="register-prompt">
        <p>Don't have an account? <a href="@Url.Action("Register", "Home")">Register</a></p>
    </div>
    <p><a href="@Url.Action("LoginCleaner", "Home")">Login as Cleaner</a></p>
</body>
</html>